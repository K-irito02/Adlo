root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{json,yaml,yml}]
indent_size = 2

[*.{ts,tsx,js,jsx,cjs,mjs}]
indent_size = 2

[*.{toml}]
indent_size = 4

[*.{ps1,psm1,psd1}]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
