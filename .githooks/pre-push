#!/bin/sh
# Install once per clone: git config core.hooksPath .githooks
# Default: affected-scope gate only (changed-file lint/format + invariants + affected tests).
# Full gate (whole suite) needs explicit human approval: set ADL_PREPUSH_FULL=1 only after approval.
set -e
ROOT="$(git rev-parse --show-toplevel)"
# Dev tooling syntax (scripts sit outside eslint/tsc scope).
( cd "$ROOT/ai-digital-life" && for f in scripts/*.mjs; do node --check "$f"; done )
# Repo-level hygiene: dev-tooling unit tests + scripts formatting + desktop E2E types.
# 与 `check:all` 共用同一聚合脚本（check:repo），避免合并门禁与推送门禁各写一套后漂移。
( cd "$ROOT/ai-digital-life" && pnpm run check:repo )
# Rust affected scope: fmt always; clippy + affected-crate unit tests when Rust files changed.
( cd "$ROOT/ai-digital-life" && node ./scripts/check-rust-changed.mjs )
# PATH injection regression: real adl-server process + temp data dir (never mutates the test env).
( cd "$ROOT/ai-digital-life" && cargo test -p adl-server --test env_path_cli )
cd "$ROOT/ai-digital-life/frontend"
if [ "$ADL_PREPUSH_FULL" = "1" ]; then
  echo "[pre-push] FULL gate (user-approved): check:full"
  pnpm check:full
else
  # Rust leg already ran above; avoid running it twice.
  ADL_SKIP_RUST=1 pnpm check:changed
fi
