#!/bin/sh
# Install once per clone: git config core.hooksPath .githooks
# Default: affected-scope gate only (changed-file lint/format + invariants + affected tests).
# Full gate (whole suite) needs explicit human approval: set ADL_PREPUSH_FULL=1 only after approval.
set -e
cd "$(git rev-parse --show-toplevel)/ai-digital-life/frontend"
if [ "$ADL_PREPUSH_FULL" = "1" ]; then
  echo "[pre-push] FULL gate (user-approved): check:full"
  pnpm check:full
else
  pnpm check:changed
fi
