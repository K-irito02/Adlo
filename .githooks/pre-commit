#!/bin/sh
# pre-commit: 快静态子集（staged 文件 + 仓库不变量）。
# 慢门禁留在原处：tsc / vitest 走 `check:changed`（dev-rules 结束验收流程强制执行）
# 与 pre-push；全量门禁需用户批准（ADL_PREPUSH_FULL=1）。
# 设计原则：hook 内只跑秒级检查；任何失败都直接阻断提交并打印修复命令。
set -e
ROOT="$(git rev-parse --show-toplevel)"
STAGED="$(git diff --cached --name-only --diff-filter=ACMR)"

# 失败步骤名：`set -e` 只给退出码，排障时必须能看出停在哪一步。
STEP="init"
on_exit() {
  code=$?
  if [ "$code" -ne 0 ]; then
    echo "[pre-commit] FAILED at step: $STEP (exit $code)" >&2
  fi
}
trap on_exit EXIT

# 1) staged 前端源码：eslint（plain, no --fix：hook 内不改写文件）
STEP="eslint"
LINTABLE="$(echo "$STAGED" | grep -E '^adlo/frontend/.*\.(ts|tsx|js|jsx|mjs|cjs)$' || true)"
if [ -n "$LINTABLE" ]; then
  echo "$LINTABLE" | sed 's|^adlo/frontend/||' | ( cd "$ROOT/adlo/frontend" && xargs -d '\n' -n 40 npx eslint )
else
  echo "[pre-commit] eslint: no staged frontend sources, skipped"
fi

# 2) staged 可格式化文件：prettier --write 自动修复后重新暂存（只动暂存文件）
STEP="prettier"
PREFILES="$(echo "$STAGED" | grep -E '^adlo/frontend/.*\.(ts|tsx|js|jsx|mjs|cjs|css|json|md)$' || true)"
if [ -n "$PREFILES" ]; then
  echo "$PREFILES" | sed 's|^adlo/frontend/||' | ( cd "$ROOT/adlo/frontend" && xargs -d '\n' -n 40 npx prettier --write )
  # 让「被 hook 规范化」可见：shell 批量改写源码（Set-Content/WriteAllLines/here-string）
  # 最常见的后果就是 CRLF/格式漂移，prettier 会静默抹平，agent 永远学不到教训。
  REFORMATTED="$(echo "$PREFILES" | while IFS= read -r f; do
    [ -n "$f" ] || continue
    if ! git -C "$ROOT" diff --quiet -- "$f"; then echo "$f"; fi
  done)"
  if [ -n "$REFORMATTED" ]; then
    echo "[pre-commit] prettier 规范化了以下暂存文件（多为行尾/格式漂移）："
    echo "$REFORMATTED" | sed 's/^/  - /'
    echo "[pre-commit] 提示：编辑源码/文档请用 edit/write 工具；禁止 shell 批量改写（见 .agents/rules/shell-encoding.md）"
  fi
  echo "$PREFILES" | while IFS= read -r f; do
    [ -n "$f" ] && git -C "$ROOT" add -- "$f"
  done
else
  echo "[pre-commit] prettier: no staged formattable files, skipped"
fi

# 2b) adlo/ 下的开发脚本与 vite 配置：与 `scripts:format` 同一集合（前端 glob 覆盖不到）
STEP="prettier (adlo tooling)"
TOOLFILES="$(echo "$STAGED" | grep -E '^adlo/(scripts/.*\.mjs|frontend/dev/.*\.mjs|frontend/vite\.config\.ts|frontend/scripts/check-vite-config\.mjs)$' || true)"
if [ -n "$TOOLFILES" ]; then
  echo "$TOOLFILES" | sed 's|^adlo/||' | ( cd "$ROOT/adlo" && xargs -d '\n' -n 20 node frontend/node_modules/prettier/bin/prettier.cjs --write )
  REFORMATTED_TOOLS="$(echo "$TOOLFILES" | while IFS= read -r f; do
    [ -n "$f" ] || continue
    if ! git -C "$ROOT" diff --quiet -- "$f"; then echo "$f"; fi
  done)"
  if [ -n "$REFORMATTED_TOOLS" ]; then
    echo "[pre-commit] prettier 规范化了以下 dev tooling 文件："
    echo "$REFORMATTED_TOOLS" | sed 's/^/  - /'
  fi
  echo "$TOOLFILES" | while IFS= read -r f; do
    [ -n "$f" ] && git -C "$ROOT" add -- "$f"
  done
else
  echo "[pre-commit] prettier (adlo tooling): no staged files, skipped"
fi

# 3) staged 脚本语法（dev tooling 在 eslint/tsc 范围外，pre-push 只在推送时查）
STEP="node --check"
MJSFILES="$(echo "$STAGED" | grep -E '^adlo/.*\.mjs$' || true)"
if [ -n "$MJSFILES" ]; then
  echo "$MJSFILES" | xargs -d '\n' -I{} sh -c 'node --check "$1"' _ {}
else
  echo "[pre-commit] node --check: no staged .mjs files, skipped"
fi

# 4) 仓库不变量（秒级）：i18n 对等、术语表、死代码、vite 配置冒烟、dev tooling 单测、删除 crate 术语
STEP="check:i18n"
( cd "$ROOT/adlo/frontend" && pnpm run check:i18n )
STEP="check:i18n:orphans"
( cd "$ROOT/adlo/frontend" && pnpm run check:i18n:orphans:changed )
STEP="check:glossary"
( cd "$ROOT/adlo/frontend" && pnpm run check:glossary )
STEP="check:css-vars"
( cd "$ROOT/adlo" && node scripts/check-css-vars.mjs )
STEP="check:dead-code"
( cd "$ROOT/adlo/frontend" && pnpm run check:dead-code )
STEP="check:vite-config"
( cd "$ROOT/adlo/frontend" && pnpm run check:vite-config )
STEP="check-brand"
( cd "$ROOT/adlo" && node scripts/check-brand.mjs )
STEP="check-stale-terms"
( cd "$ROOT/adlo" && node scripts/check-stale-terms.mjs )
STEP="check-deleted-crates"
( cd "$ROOT/adlo" && node scripts/check-deleted-crates.mjs )
STEP="check-no-new-any"
( cd "$ROOT/adlo" && node scripts/check-no-new-any.mjs )
STEP="dev tooling tests"
( cd "$ROOT/adlo" && node --test "scripts/*.test.mjs" )

echo "[pre-commit] OK (tsc + vitest stay in check:changed / pre-push)"
