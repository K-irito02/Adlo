t-soft: rgba(145, 207, 213, 0.16);\n  --accent-contrast: #050d1c;\n  --info: #7cc1f5;\n  --info-soft: rgba(124, 193, 245, 0.14);\n  --success: #34d399;\n  --success-soft: rgba(52, 211, 153, 0.14);\n  --warning: #fbbf24;\n  --warning-soft: rgba(251, 191, 36, 0.14);\n  --danger: #f87171;\n  --danger-soft: rgba(248, 113, 113, 0.14);\n  --focus-ring: rgba(145, 207, 213, 0.45);\n  --shadow-soft: 0 28px 80px rgba(0, 0, 0, 0.6);\n}\n\n/* -------- Backwards-compatible single [data-theme] selectors --------\n   The legacy bridge sets only data-theme; map those to scheme-2.       */\n\n[data-theme=\"light\"]:not([data-color-scheme]) {\n  --bg: #f6f7f9;\n  --bg-strong: #ffffff;\n  --text-primary: #101828;\n  --accent: #2563eb;\n  --accent-soft: rgba(37, 99, 235, 0.1);\n}\n\n[data-theme=\"dark\"]:not([data-color-scheme]) {\n  --bg: #0b1224;\n  --bg-strong: #111a33;\n  --text-primary: #f5efea;\n  --accent: #f5efea;\n  --accent-soft: rgba(245, 239, 234, 0.12);\n}\n\n/* -------- High-contrast preference --------\n   Boost border + focus ring opacity for users who request more contrast.  */\n\n@media (prefers-contrast: more) {\n  :root {\n    --border-subtle: rgba(15, 23, 42, 0.32);\n    --border-default: rgba(15, 23, 42, 0.5);\n    --focus-ring-width: 4px;\n  }\n  [data-theme=\"dark\"] {\n    --border-subtle: rgba(245, 239, 234, 0.4);\n    --border-default: rgba(245, 239, 234, 0.6);\n  }\n}\n\n/* ==========================================================================\n   Base\n   --------------------------------------------------------------------------\n   - CSS reset (modern, minimal)\n   - Body background recipes per theme\n   - Selection / scrollbar / focus-visible defaults\n   - Reduced motion + reduced data adjustments\n   ========================================================================== */\n\n*,\n*::before,\n*::after {\n  box-sizing: border-box;\n}\n\nhtml,\nbody {\n  height: 100%;\n  margin: 0;\n  padding: 0;\n}\n\nhtml {\n  font-size: 16px;\n  -webkit-text-size-adjust: 100%;\n  text-rendering: optimizeLegibility;\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n}\n\nbody {\n  font-family: var(--font-sans);\n  font-size: var(--text-base);\n  line-height: var(--leading-normal);\n  color: var(--text-primary);\n  background: var(--bg);\n  background-attachment: fixed;\n  overflow-y: scroll;\n}\n\n/* Each theme provides a tailored radial backdrop. Avoid scroll-thrash by\n   enabling a fallback background colour first. */\n\n[data-theme=\"light\"] body {\n  /* Minimal canvas: flat tone with a whisper of depth (no heavy gradients) */\n  background: var(--bg);\n}\n\n[data-theme=\"dark\"] body {\n  background:\n    radial-gradient(circle at top left, var(--accent-soft) 0%, transparent 28%),\n    radial-gradient(circle at top right, var(--info-soft) 0%, transparent 24%),\n    linear-gradient(160deg, var(--bg) 0%, #000 200%);\n}\n\nh1,\nh2,\nh3,\nh4,\nh5,\nh6 {\n  margin: 0;\n  font-family: var(--font-display);\n  font-weight: var(--font-semibold);\n  letter-spacing: var(--tracking-tight);\n  color: var(--text-primary);\n}\n\np {\n  margin: 0;\n  line-height: var(--leading-relaxed);\n}\n\na {\n  color: var(--accent);\n  text-decoration: none;\n  transition: var(--transition-colors);\n}\n\na:hover {\n  text-decoration: underline;\n}\n\nul,\nol {\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\nimg,\nsvg {\n  display: block;\n  max-width: 100%;\n}\n\nbutton,\ninput,\nselect,\ntextarea {\n  font: inherit;\n  color: inherit;\n}\n\nbutton {\n  cursor: pointer;\n  background: none;\n  border: 0;\n  padding: 0;\n}\n\n::selection {\n  background: var(--accent-soft);\n  color: var(--text-primary);\n}\n\n::placeholder {\n  color: var(--text-muted);\n  opacity: 1;\n}\n\n/* --- Focus visibility --- */\n\n:focus-visible {\n  outline: 0;\n  box-shadow: 0 0 0 var(--focus-ring-width) var(--focus-ring);\n  border-radius: inherit;\n}\n\n/* --- Scrollbar (WebKit + Firefox) --- */\n\n* {\n  scrollbar-color: var(--border-default) transparent;\n  scrollbar-width: thin;\n}\n\n::-webkit-scrollbar {\n  width: 10px;\n  height: 10px;\n}\n\n::-webkit-scrollbar-thumb {\n  background: var(--border-default);\n  border-radius: var(--radius-full);\n  border: 2px solid transparent;\n  background-clip: padding-box;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  background: var(--border-strong);\n  background-clip: padding-box;\n  border: 2px solid transparent;\n}\n\n::-webkit-scrollbar-track {\n  background: transparent;\n}\n\n/* --- Reduced motion: keep transforms calm --- */\n\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    animation-duration: 1ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 1ms !important;\n    scroll-behavior: auto !important;\n  }\n}\n\n/* --- Reduced data: drop expensive backdrops --- */\n\n@media (prefers-reduced-data: reduce) {\n  body {\n    background: var(--bg);\n  }\n}\n\n/* ==========================================================================\n   Layout\n   --------------------------------------------------------------------------\n   - App shell: titlebar / sidebar / content / statusbar\n   - Responsive grid system (12-col + dashboard / two-col / three-col presets)\n   - Container widths (fluid / standard / wide / narrow)\n   - Page header / content scroll area\n   ========================================================================== */\n\n/* -------- App shell -------- */\n\n.app-shell {\n  display: grid;\n  grid-template-rows: var(--titlebar-height) 1fr var(--statusbar-height);\n  min-height: 100vh;\n  min-height: 100dvh;\n}\n\n.app-shell__titlebar {\n  display: flex;\n  align-items: center;\n  gap: var(--space-3);\n  padding: 0 var(--space-4);\n  background: var(--bg-elevated);\n  border-bottom: 1px solid var(--border-subtle);\n  -webkit-app-region: drag;\n  user-select: none;\n}\n\n.app-shell__titlebar > button,\n.app-shell__titlebar > a {\n  -webkit-app-region: no-drag;\n}\n\n.app-shell__brand {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--space-2);\n  font-weight: var(--font-semibold);\n}\n\n.app-shell__brand-name {\n  font-size: var(--text-sm);\n}\n\n.app-shell__brand-meta {\n  font-size: var(--text-xs);\n  color: var(--text-muted);\n}\n\n.app-shell__titlebar-spacer {\n  flex: 1 1 auto;\n}\n\n.app-shell__body {\n  display: grid;\n  grid-template-columns: var(--sidebar-width) 1fr;\n  min-height: 0;\n}\n\n.app-shell__sidebar {\n  border-right: 1px solid var(--border-subtle);\n  background: var(--bg-elevated);\n  padding: var(--space-4) var(--space-3);\n  overflow-y: auto;\n}\n\n.app-shell__main {\n  min-width: 0;\n  overflow-y: auto;\n  scroll-behavior: smooth;\n}\n\n.app-shell__statusbar {\n  display: flex;\n  align-items: center;\n  gap: var(--space-3);\n  padding: 0 var(--space-4);\n  background: var(--bg-elevated);\n  border-top: 1px solid var(--border-subtle);\n  font-size: var(--text-xs);\n  color: var(--text-muted);\n  white-space: nowrap;\n  overflow-x: auto;\n}\n\n/* -------- Sidebar nav -------- */\n\n.nav {\n  display: grid;\n  gap: var(--space-1);\n}\n\n.nav__group-label {\n  margin: var(--space-3) var(--space-2) var(--space-1);\n  font-size: var(--text-xs);\n  font-weight: var(--font-semibold);\n  letter-spacing: var(--tracking-wider);\n  text-transform: uppercase;\n  color: var(--text-muted);\n}\n\n.nav__item {\n  display: flex;\n  align-items: center;\n  gap: var(--space-3);\n  padding: var(--space-2-5) var(--space-3);\n  border-radius: var(--radius-lg);\n  color: var(--text-secondary);\n  font-weight: var(--font-medium);\n  font-size: var(--text-sm);\n  transition: var(--transition-colors);\n}\n\n.nav__item:hover {\n  background: var(--bg-muted);\n  color: var(--text-primary);\n}\n\n.nav__item[aria-current=\"page\"] {\n  background: var(--accent-soft);\n  color: var(--accent);\n}\n\n.nav__item .icon {\n  flex-shrink: 0;\n}\n\n/* -------- Page container -------- */\n\n.page {\n  padding: var(--space-6);\n  max-width: var(--content-max-width);\n  margin: 0 auto;\n  display: grid;\n  gap: var(--space-6);\n}\n\n.page__header {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: var(--space-4);\n  flex-wrap: wrap;\n}\n\n.page__title {\n  font-size: var(--text-3xl);\n  line-height: var(--leading-tight);\n  margin: 0;\n}\n\n.page__subtitle {\n  margin-top: var(--space-1-5);\n  color: var(--text-muted);\n  font-size: var(--text-sm);\n}\n\n.page__toolbar {\n  display: flex;\n  align-items: center;\n  gap: var(--space-2);\n  flex-wrap: wrap;\n}\n\n/* -------- Grid presets -------- */\n\n.grid {\n  display: grid;\n  gap: var(--space-6);\n}\n\n.grid--cols-2 {\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n\n.grid--cols-3 {\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n}\n\n.grid--dashboard {\n  /* 1.1 / 0.9 / 1 ratio matches Stage One dashboard spec */\n  grid-template-columns: 1.1fr 0.9fr 1fr;\n}\n\n/* -------- Container -------- */\n\n.container {\n  width: 100%;\n  max-width: 1280px;\n  margin: 0 auto;\n  padding: 0 var(--space-6);\n}\n\n.container--wide {\n  max-width: var(--content-max-width);\n}\n\n.container--narrow {\n  max-width: 960px;\n}\n\n/* -------- Stack helpers -------- */\n\n.stack {\n  display: grid;\n  gap: var(--space-4);\n}\n\n.stack--sm {\n  gap: var(--space-2);\n}\n\n.stack--lg {\n  gap: var(--space-6);\n}\n\n.cluster {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--space-2);\n  align-items: center;\n}\n\n/* -------- Responsive: tablet (≤ 1280px) -------- */\n\n@media (max-width: 1280px) {\n  .grid--dashboard {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .grid--dashboard > :last-child {\n    grid-column: 1 / -1;\n  }\n\n  .grid--cols-3 {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n}\n\n/* -------- Responsive: small tablet / large phone (≤ 960px) -------- */\n\n@media (max-width: 960px) {\n  .app-shell__body {\n    grid-template-columns: var(--sidebar-width-collapsed) 1fr;\n  }\n\n  .app-shell__sidebar {\n    padding: var(--space-3) var(--space-2);\n  }\n\n  .nav__item {\n    justify-content: center;\n    padding: var(--space-3);\n  }\n\n  .nav__item-label {\n    display: none;\n  }\n\n  .page {\n    padding: var(--space-4);\n    gap: var(--space-4);\n  }\n\n  .grid--dashboard,\n  .grid--cols-2,\n  .grid--cols-3 {\n    grid-template-columns: 1fr;\n  }\n}\n\n/* -------- Responsive: phone (≤ 640px) -------- */\n\n@media (max-width: 640px) {\n  .app-shell {\n    grid-template-rows: var(--titlebar-height) 1fr auto;\n  }\n\n  .app-shell__body {\n    grid-template-columns: 1fr;\n  }\n\n  .app-shell__sidebar {\n    display: none;\n  }\n\n  .page__title {\n    font-size: var(--text-2xl);\n  }\n}\n\n/* ==========================================================================\n   Components\n   --------------------------------------------------------------------------\n   - All component classes use BEM-style naming (block / block__element /\n     block--modifier).\n   - Components MUST consume tokens. No raw colors.\n   - Every interactive component covers default / hover / focus / active /\n     disabled / loading / busy states.\n   ========================================================================== */\n\n/* -------- Icon -------- */\n\n.icon {\n  display: inline-flex;\n  flex-shrink: 0;\n  width: var(--icon-md);\n  height: var(--icon-md);\n  vertical-align: middle;\n  color: currentColor;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 2;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.icon--xs {\n  width: var(--icon-xs);\n  height: var(--icon-xs);\n}\n\n.icon--sm {\n  width: var(--icon-sm);\n  height: var(--icon-sm);\n}\n\n.icon--md {\n  width: var(--icon-md);\n  height: var(--icon-md);\n}\n\n.icon--lg {\n  width: var(--icon-lg);\n  height: var(--icon-lg);\n}\n\n.icon--xl {\n  width: var(--icon-xl);\n  height: var(--icon-xl);\n}\n\n/* -------- Button -------- */\n\n.btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--space-2);\n  padding: var(--space-2-5) var(--space-4);\n  border-radius: var(--radius-lg);\n  border: 1px solid transparent;\n  background: var(--accent);\n  color: var(--text-on-accent);\n  font-size: var(--text-sm);\n  font-weight: var(--font-semibold);\n  line-height: var(--leading-tight);\n  white-space: nowrap;\n  transition:\n    var(--transition-colors),\n    var(--transition-shadow),\n    var(--transition-transform);\n  position: relative;\n  isolation: isolate;\n}\n\n.btn:hover:not([disabled]):not([aria-busy=\"true\"]) {\n  background: var(--accent-hover);\n}\n\n.btn:active:not([disabled]) {\n  background: var(--accent-active);\n  transform: translateY(1px);\n}\n\n.btn[disabled],\n.btn[aria-disabled=\"true\"] {\n  opacity: 0.55;\n  cursor: not-allowed;\n  pointer-events: none;\n}\n\n.btn[aria-busy=\"true\"] {\n  cursor: progress;\n  pointer-events: none;\n  color: transparent;\n}\n\n.btn[aria-busy=\"true\"]::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  margin: auto;\n  width: 16px;\n  height: 16px;\n  border: 2px solid currentColor;\n  border-right-color: transparent;\n  border-radius: var(--radius-full);\n  color: var(--text-on-accent);\n  animation: spin 800ms linear infinite;\n}\n\n.btn--secondary {\n  background: transparent;\n  color: var(--text-primary);\n  border-color: var(--border-default);\n}\n\n.btn--secondary:hover:not([disabled]) {\n  background: var(--bg-muted);\n  border-color: var(--border-strong);\n}\n\n.btn--secondary:active:not([disabled]) {\n  background: var(--bg-muted);\n}\n\n.btn--ghost {\n  background: transparent;\n  color: var(--text-secondary);\n}\n\n.btn--ghost:hover:not([disabled]) {\n  background: var(--bg-muted);\n  color: var(--text-primary);\n}\n\n.btn--danger {\n  background: var(--danger);\n  color: #fff;\n}\n\n.btn--danger:hover:not([disabled]) {\n  background: var(--danger);\n  filter: brightness(0.92);\n}\n\n.btn--icon {\n  width: var(--space-8);\n  height: var(--space-8);\n  padding: 0;\n  border-radius: var(--radius-md);\n}\n\n.btn--sm {\n  padding: var(--space-1-5) var(--space-3);\n  font-size: var(--text-xs);\n  border-radius: var(--radius-md);\n}\n\n.btn--lg {\n  padding: var(--space-3) var(--space-5);\n  font-size: var(--text-base);\n}\n\n.btn--block {\n  width: 100%;\n}\n\n/* -------- Segmented control / toggle group -------- */\n\n.segmented {\n  display: inline-grid;\n  grid-auto-flow: column;\n  gap: var(--space-1);\n  padding: var(--space-1);\n  border-radius: var(--radius-xl);\n  background: var(--bg-muted);\n  border: 1px solid var(--border-subtle);\n}\n\n.segmented__btn {\n  min-width: 96px;\n  padding: var(--space-2) var(--space-3);\n  border-radius: var(--radius-lg);\n  background: transparent;\n  color: var(--text-muted);\n  font-size: var(--text-sm);\n  font-weight: var(--font-medium);\n  transition: var(--transition-colors);\n}\n\n.segmented__btn:hover:not([disabled]):not([aria-pressed=\"true\"]) {\n  color: var(--text-primary);\n  background: var(--bg-strong);\n}\n\n.segmented__btn[aria-pressed=\"true\"] {\n  background: var(--accent);\n  color: var(--text-on-accent);\n}\n\n/* -------- Input / Textarea -------- */\n\n.input,\n.textarea,\n.select {\n  width: 100%;\n  padding: var(--space-3) var(--space-3-5);\n  border: 1px solid var(--border-default);\n  border-radius: var(--radius-lg);\n  background: var(--surface);\n  color: var(--text-primary);\n  font-size: var(--text-sm);\n  line-height: var(--leading-normal);\n  transition:\n    var(--transition-colors),\n    var(--transition-shadow);\n}\n\n.input:hover,\n.textarea:hover,\n.select:hover {\n  border-color: var(--border-strong);\n}\n\n.input:focus-visible,\n.textarea:focus-visible,\n.select:focus-visible {\n  border-color: var(--accent);\n  box-shadow: 0 0 0 var(--focus-ring-width) var(--focus-ring);\n  outline: 0;\n}\n\n.input[aria-invalid=\"true\"],\n.textarea[aria-invalid=\"true\"] {\n  border-color: var(--danger);\n}\n\n.textarea {\n  min-height: 96px;\n  resize: vertical;\n  font-family: inherit;\n}\n\n.select--sm,\n.input--sm {\n  min-height: 36px;\n  padding: var(--space-2) var(--space-3);\n  font-size: var(--text-xs);\n  border-radius: var(--radius-md);\n}\n\n.input--mono {\n  font-family: var(--font-mono);\n}\n\n.field {\n  display: grid;\n  gap: var(--space-1-5);\n}\n\n.field__label {\n  font-size: var(--text-xs);\n  font-weight: var(--font-semibold);\n  color: var(--text-secondary);\n  letter-spacing: var(--tracking-wide);\n}\n\n.field__hint {\n  font-size: var(--text-xs);\n  color: var(--text-muted);\n}\n\n.field__error {\n  font-size: var(--text-xs);\n  color: var(--danger);\n}\n\n/* -------- Card / Panel -------- */\n\n.card {\n  background: var(--surface);\n  border: 1px solid var(--border-subtle);\n  border-radius: var(--radius-xl);\n  box-shadow: var(--shadow-sm);\n  padding: var(--space-5);\n  display: grid;\n  gap: var(--space-3);\n}\n\n.card__header {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: var(--space-3);\n}\n\n.card__title {\n  font-size: var(--text-lg);\n  font-weight: var(--font-semibold);\n  margin: 0;\n}\n\n.card__subtitle {\n  margin: 0;\n  font-size: var(--text-sm);\n  color: var(--text-muted);\n}\n\n.card__body {\n  display: grid;\n  gap: var(--space-3);\n}\n\n.card--inset {\n  background: var(--surface-sunken);\n  box-shadow: none;\n  backdrop-filter: none;\n}\n\n/* -------- List item / Surface tile -------- */\n\n.tile {\n  border: 1px solid var(--border-subtle);\n  border-radius: var(--radius-xl);\n  padding: var(--space-3-5);\n  background: var(--surface);\n  display: grid;\n  gap: var(--space-2);\n  transition:\n    var(--transition-colors),\n    var(--transition-shadow);\n}\n\n[data-theme=\"dark\"] .tile {\n  background: var(--surface-elevated);\n}\n\n.tile:hover {\n  border-color: var(--border-default);\n  box-shadow: var(--shadow);\n}\n\n.tile--disabled {\n  opacity: 0.6;\n}\n\n.tile__row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--space-3);\n  flex-wrap: wrap;\n}\n\n.tile__title {\n  font-weight: var(--font-semibold);\n  font-size: var(--text-sm);\n}\n\n.tile__meta {\n  font-size: var(--text-xs);\n  color: var(--text-muted);\n}\n\n.tile__detail {\n  font-size: var(--text-sm);\n  color: var(--text-secondary);\n}\n\n/* -------- Pill / Badge / Risk pill -------- */\n\n.pill {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--space-1);\n  padding: var(--space-0-5) var(--space-2);\n  border-radius: var(--radius-full);\n  font-size: var(--text-xs);\n  font-weight: var(--font-semibold);\n  letter-spacing: var(--tracking-wide);\n  background: var(--bg-muted);\n  color: var(--text-secondary);\n  white-space: nowrap;\n  line-height: var(--leading-none);\n  min-height: 22px;\n}\n\n.pill--healthy,\n.pill--success {\n  background: var(--success-soft);\n  color: var(--success);\n}\n\n.pill--degraded,\n.pill--pending,\n.pill--warning {\n  background: var(--warning-soft);\n  color: var(--warning);\n}\n\n.pill--unavailable,\n.pill--danger {\n  background: var(--danger-soft);\n  color: var(--danger);\n}\n\n.pill--info {\n  background: var(--info-soft);\n  color: var(--info);\n}\n\n.pill--accent {\n  background: var(--accent-soft);\n  color: var(--accent);\n}\n\n/* status dot (paired with text) */\n\n.status-dot {\n  display: inline-block;\n  width: 8px;\n  height: 8px;\n  border-radius: var(--radius-full);\n  background: currentColor;\n  margin-right: var(--space-1-5);\n}\n\n/* -------- Eyebrow -------- */\n\n.eyebrow {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--space-2);\n  border-radius: var(--radius-full);\n  padding: var(--space-1) var(--space-3);\n  background: var(--accent-soft);\n  color: var(--accent);\n  font-size: var(--text-xs);\n  font-weight: var(--font-bold);\n  letter-spacing: var(--tracking-widest);\n  text-transform: uppercase;\n}\n\n/* -------- Banner / Inline alert -------- */\n\n.banner {\n  display: flex;\n  align-items: flex-start;\n  gap: var(--space-3);\n  padding: var(--space-3) var(--space-4);\n  border-radius: var(--radius-xl);\n  background: var(--bg-muted);\n  border: 1px solid var(--border-subtle);\n  font-size: var(--text-sm);\n  color: var(--text-secondary);\n  min-height: 24px;\n}\n\n.banner--neutral {\n  background: var(--bg-muted);\n}\n\n.banner--success {\n  background: var(--success-soft);\n  color: var(--success);\n  border-color: transparent;\n}\n\n.banner--warning {\n  background: var(--warning-soft);\n  color: var(--warning);\n  border-color: transparent;\n}\n\n.banner--error,\n.banner--danger {\n  background: var(--danger-soft);\n  color: var(--danger);\n  border-color: transparent;\n}\n\n.banner--empty {\n  visibility: hidden;\n  min-height: 24px;\n}\n\n/* -------- Skeleton -------- */\n\n.skeleton {\n  display: block;\n  background: linear-gradient(\n    90deg,\n    var(--bg-muted) 0%,\n    var(--surface-sunken) 50%,\n    var(--bg-muted) 100%\n  );\n  background-size: 200% 100%;\n  animation: skeleton-shimmer 1500ms ease-in-out infinite;\n  border-radius: var(--radius-md);\n  min-height: 14px;\n}\n\n@keyframes skeleton-shimmer {\n  0% {\n    background-position: 200% 0;\n  }\n  100% {\n    background-position: -200% 0;\n  }\n}\n\n@keyframes spin {\n  to {\n    transform: rotate(360deg);\n  }\n}\n\n/* -------- Empty state -------- */\n\n.empty-state {\n  display: grid;\n  place-items: center;\n  gap: var(--space-3);\n  padding: var(--space-8) var(--space-6);\n  color: var(--text-muted);\n  text-align: center;\n}\n\n.empty-state__title {\n  color: var(--text-secondary);\n  font-weight: var(--font-semibold);\n}\n\n/* -------- Modal -------- */\n\n.modal-backdrop {\n  position: fixed;\n  inset: 0;\n  background: var(--bg-overlay);\n  backdrop-filter: blur(4px);\n  z-index: var(--z-modal-backdrop);\n  display: grid;\n  place-items: center;\n  padding: var(--space-6);\n  animation: fade-in var(--duration-200) var(--ease-enter);\n}\n\n.modal {\n  background: var(--surface-elevated);\n  border-radius: var(--radius-2xl);\n  box-shadow: var(--shadow-2xl);\n  padding: var(--space-6);\n  max-width: 520px;\n  width: 100%;\n  display: grid;\n  gap: var(--space-4);\n  z-index: var(--z-modal);\n  animation:\n    fade-in var(--duration-200) var(--ease-enter),\n    scale-in var(--duration-200) var(--ease-enter);\n}\n\n.modal__title {\n  font-size: var(--text-xl);\n  font-weight: var(--font-semibold);\n}\n\n.modal__actions {\n  display: flex;\n  justify-content: flex-end;\n  gap: var(--space-2);\n  margin-top: var(--space-2);\n}\n\n@keyframes fade-in {\n  from {\n    opacity: 0;\n  }\n  to {\n    opacity: 1;\n  }\n}\n\n@keyframes scale-in {\n  from {\n    transform: scale(0.96);\n  }\n  to {\n    transform: scale(1);\n  }\n}\n\n/* -------- Tooltip -------- */\n\n.tooltip {\n  position: absolute;\n  z-index: var(--z-tooltip);\n  background: var(--text-primary);\n  color: var(--bg);\n  padding: var(--space-1) var(--space-2);\n  border-radius: var(--radius-md);\n  font-size: var(--text-xs);\n  pointer-events: none;\n  opacity: 0;\n  transition: opacity var(--duration-100) var(--ease-default);\n  max-width: 240px;\n}\n\n.tooltip[data-open=\"true\"] {\n  opacity: 1;\n}\n\n/* -------- Toast -------- */\n\n.toast-region {\n  position: fixed;\n  top: var(--space-6);\n  right: var(--space-6);\n  z-index: var(--z-toast);\n  display: grid;\n  gap: var(--space-2);\n  pointer-events: none;\n  max-width: 420px;\n}\n\n.toast {\n  pointer-events: auto;\n  background: var(--surface-elevated);\n  border: 1px solid var(--border-subtle);\n  border-radius: var(--radius-xl);\n  padding: var(--space-3) var(--space-4);\n  box-shadow: var(--shadow-lg);\n  display: flex;\n  gap: var(--space-3);\n  align-items: flex-start;\n  animation: toast-in var(--duration-200) var(--ease-enter);\n}\n\n@keyframes toast-in {\n  from {\n    opacity: 0;\n    transform: translateY(-8px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n/* -------- Health item / Stat -------- */\n\n.stat {\n  display: grid;\n  gap: var(--space-1-5);\n  padding: var(--space-3-5);\n  border-radius: var(--radius-xl);\n  border: 1px solid var(--border-subtle);\n  background: var(--surface);\n}\n\n[data-theme=\"dark\"] .stat {\n  background: var(--surface-elevated);\n}\n\n.stat__label {\n  font-size: var(--text-xs);\n  font-weight: var(--font-semibold);\n  letter-spacing: var(--tracking-wider);\n  text-transform: uppercase;\n  color: var(--text-muted);\n}\n\n.stat__value {\n  font-size: var(--text-lg);\n  font-weight: var(--font-semibold);\n  color: var(--text-primary);\n}\n\n.stat__detail {\n  font-size: var(--text-xs);\n  color: var(--text-muted);\n}\n\n/* -------- Mono / Subtitle helpers -------- */\n\n.mono {\n  font-family: var(--font-mono);\n  font-size: var(--text-xs);\n  color: var(--text-muted);\n  word-break: break-all;\n}\n\n.text-muted {\n  color: var(--text-muted);\n}\n\n.text-secondary {\n  color: var(--text-secondary);\n}\n\n/* -------- Color scheme picker -------- */\n\n.color-scheme {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--space-1);\n  padding: var(--space-1);\n  border-radius: var(--radius-full);\n  background: var(--bg-muted);\n  border: 1px solid var(--border-subtle);\n}\n\n.color-scheme__btn {\n  width: 22px;\n  height: 22px;\n  border-radius: var(--radius-full);\n  background: transparent;\n  display: inline-grid;\n  place-items: center;\n  padding: 0;\n  border: 2px solid transparent;\n  cursor: pointer;\n  transition: var(--transition-transform), var(--transition-colors);\n}\n\n.color-scheme__btn:hover {\n  transform: scale(1.1);\n}\n\n.color-scheme__btn--active {\n  border-color: var(--text-primary);\n}\n\n.color-scheme__swatch {\n  display: block;\n  width: 14px;\n  height: 14px;\n  border-radius: var(--radius-full);\n  box-shadow: inset 0 0 0 1px var(--border-default);\n}\n\n/* -------- Form layout -------- */\n\n.form-row {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto;\n  gap: var(--space-3);\n}\n\n@media (max-width: 640px) {\n  .form-row {\n    grid-template-columns: 1fr;\n  }\n}\n\n/* ==========================================================================\n   Phase 2 workspace (renderer) — IDE layout\n   Cursor/VS Code-like: full bleed, activity bar, sidebars, status bar\n   ========================================================================== */\n\n.adl-ide {\n  display: grid;\n  grid-template-rows: var(--titlebar-height) 1fr var(--statusbar-height);\n  height: 100vh;\n  height: 100dvh;\n  background: var(--bg);\n  color: var(--text-primary);\n  overflow: hidden;\n}\n\n.adl-ide-loading {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  height: 100vh;\n  background: var(--bg);\n  color: var(--text-muted);\n}\n\n.adl-ide-titlebar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 0 var(--space-4);\n  height: var(--titlebar-height);\n  background: var(--surface);\n  border-bottom: 1px solid var(--border-subtle);\n  -webkit-app-region: drag;\n  user-select: none;\n  gap: var(--space-3);\n}\n\n.adl-ide-titlebar > * {\n  -webkit-app-region: no-drag;\n}\n\n.adl-ide-titlebar-brand {\n  display: flex;\n  align-items: center;\n  gap: var(--space-3);\n  font-size: var(--text-sm);\n  font-weight: var(--font-medium);\n  color: var(--text-primary);\n  flex-shrink: 0;\n}\n\n.adl-ide-titlebar-brand .pill {\n  font-size: 10px;\n  padding: 2px 8px;\n}\n\n.adl-ide-titlebar-actions {\n  display: flex;\n  align-items: center;\n  gap: var(--space-2);\n  flex-shrink: 0;\n}\n\n.adl-ide-titlebar-controls {\n  display: flex;\n  align-items: center;\n  gap: var(--space-0-5);\n  margin-left: var(--space-2);\n  padding-left: var(--space-3);\n  border-left: 1px solid var(--border-subtle);\n  flex-shrink: 0;\n}\n\n.adl-titlebar-control-btn {\n  display: grid;\n  place-items: center;\n  width: 28px;\n  height: 28px;\n  border: none;\n  border-radi