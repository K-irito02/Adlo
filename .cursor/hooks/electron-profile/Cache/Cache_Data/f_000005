const __vite__css = "/* ==========================================================================\n   AI Digital Life - Desktop Renderer Stylesheet\n   --------------------------------------------------------------------------\n   Single import surface. Order matters:\n     1. tokens     - design primitives (CSS custom properties)\n     2. themes     - color schemes × theme modes\n     3. base       - resets, body backdrop, focus, scrollbar\n     4. layout     - app shell, sidebar, page, grid presets\n     5. components - Button / Input / Card / Badge / Modal / Toast / etc.\n     6. utilities  - sr-only, focus helpers, spacing utilities\n   ========================================================================== */\n\n/* ==========================================================================\n   Design Tokens\n   --------------------------------------------------------------------------\n   - Spacing / Typography / Radius / Shadow / Motion / Z-index / Breakpoints\n   - All tokens are CSS Custom Properties, semantic names only.\n   - Components MUST consume these tokens; raw values are not allowed.\n   - Token vocabulary mirrors digitalLife/aiFunction-Implementation/stageOne-UI\n   ========================================================================== */\n\n:root {\n  color-scheme: light dark;\n\n  /* --- Spacing (4px grid) --- */\n  --space-0: 0;\n  --space-px: 1px;\n  --space-0-5: 2px;\n  --space-1: 4px;\n  --space-1-5: 6px;\n  --space-2: 8px;\n  --space-2-5: 10px;\n  --space-3: 12px;\n  --space-3-5: 14px;\n  --space-4: 16px;\n  --space-5: 20px;\n  --space-6: 24px;\n  --space-7: 28px;\n  --space-8: 32px;\n  --space-10: 40px;\n  --space-12: 48px;\n  --space-14: 56px;\n  --space-16: 64px;\n  --space-20: 80px;\n  --space-24: 96px;\n\n  /* --- Typography Family --- */\n  --font-sans:\n    \"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\",\n    \"Microsoft YaHei\", \"Noto Sans SC\", \"Helvetica Neue\", Arial, sans-serif;\n  --font-mono:\n    \"JetBrains Mono\", \"Fira Code\", \"Cascadia Code\", \"Consolas\", \"Menlo\",\n    \"Liberation Mono\", \"Courier New\", monospace;\n  --font-display: var(--font-sans);\n\n  /* --- Typography Size (1.25 ratio) --- */\n  --text-xs: 12px;\n  --text-sm: 14px;\n  --text-base: 16px;\n  --text-lg: 18px;\n  --text-xl: 20px;\n  --text-2xl: 24px;\n  --text-3xl: 30px;\n  --text-4xl: 36px;\n  --text-5xl: 48px;\n\n  /* --- Line Height --- */\n  --leading-none: 1;\n  --leading-tight: 1.25;\n  --leading-snug: 1.375;\n  --leading-normal: 1.5;\n  --leading-relaxed: 1.625;\n\n  /* --- Font Weight --- */\n  --font-light: 300;\n  --font-normal: 400;\n  --font-medium: 500;\n  --font-semibold: 600;\n  --font-bold: 700;\n  --font-extrabold: 800;\n\n  /* --- Letter Spacing --- */\n  --tracking-tight: -0.025em;\n  --tracking-normal: 0;\n  --tracking-wide: 0.025em;\n  --tracking-wider: 0.05em;\n  --tracking-widest: 0.1em;\n\n  /* --- Radius --- */\n  --radius-none: 0;\n  --radius-sm: 2px;\n  --radius: 4px;\n  --radius-md: 6px;\n  --radius-lg: 8px;\n  --radius-xl: 12px;\n  --radius-2xl: 16px;\n  --radius-3xl: 24px;\n  --radius-full: 9999px;\n\n  /* --- Shadow (light theme variants) --- */\n  --shadow-none: none;\n  --shadow-sm: 0 1px 2px 0 rgba(15, 23, 42, 0.05);\n  --shadow:\n    0 1px 3px 0 rgba(15, 23, 42, 0.1),\n    0 1px 2px -1px rgba(15, 23, 42, 0.06);\n  --shadow-md:\n    0 4px 6px -1px rgba(15, 23, 42, 0.1),\n    0 2px 4px -2px rgba(15, 23, 42, 0.06);\n  --shadow-lg:\n    0 10px 15px -3px rgba(15, 23, 42, 0.1),\n    0 4px 6px -4px rgba(15, 23, 42, 0.05);\n  --shadow-xl:\n    0 20px 25px -5px rgba(15, 23, 42, 0.1),\n    0 8px 10px -6px rgba(15, 23, 42, 0.05);\n  --shadow-2xl: 0 25px 50px -12px rgba(15, 23, 42, 0.25);\n  --shadow-inner: inset 0 2px 4px 0 rgba(15, 23, 42, 0.05);\n\n  /* --- Motion: Duration --- */\n  --duration-75: 75ms;\n  --duration-100: 100ms;\n  --duration-150: 150ms;\n  --duration-200: 200ms;\n  --duration-300: 300ms;\n  --duration-500: 500ms;\n  --duration-700: 700ms;\n  --duration-1000: 1000ms;\n\n  /* --- Motion: Easing --- */\n  --ease-linear: linear;\n  --ease-default: cubic-bezier(0.4, 0, 0.2, 1);\n  --ease-enter: cubic-bezier(0, 0, 0.2, 1);\n  --ease-exit: cubic-bezier(0.4, 0, 1, 1);\n  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);\n  --ease-snap: cubic-bezier(0, 0.8, 0.2, 1);\n\n  /* --- Common transitions --- */\n  --transition-colors:\n    color var(--duration-150) var(--ease-default),\n    background-color var(--duration-150) var(--ease-default),\n    border-color var(--duration-150) var(--ease-default);\n  --transition-shadow: box-shadow var(--duration-150) var(--ease-default);\n  --transition-transform: transform var(--duration-200) var(--ease-default);\n  --transition-opacity: opacity var(--duration-150) var(--ease-default);\n  --transition-modal:\n    opacity var(--duration-200) var(--ease-enter),\n    transform var(--duration-200) var(--ease-enter);\n\n  /* --- Z-index Layers --- */\n  --z-base: 0;\n  --z-raised: 10;\n  --z-dropdown: 20;\n  --z-sticky: 30;\n  --z-overlay: 40;\n  --z-modal-backdrop: 50;\n  --z-modal: 60;\n  --z-popover: 70;\n  --z-toast: 80;\n  --z-tooltip: 90;\n  --z-max: 9999;\n\n  /* --- Icon size tokens --- */\n  --icon-xs: 12px;\n  --icon-sm: 16px;\n  --icon-md: 20px;\n  --icon-lg: 24px;\n  --icon-xl: 32px;\n  --icon-2xl: 48px;\n\n  /* --- Layout tokens --- */\n  --titlebar-height: 36px;\n  --statusbar-height: 28px;\n  --sidebar-width: 248px;\n  --sidebar-width-collapsed: 64px;\n  --content-max-width: 1440px;\n\n  /* --- Focus ring (themed in themes.css) --- */\n  --focus-ring-width: 3px;\n  --focus-ring-offset: 2px;\n\n  /* --- Reduced motion --- */\n  --motion-scale: 1;\n}\n\n/* Respect user preference for reduced motion. Components that opt-in\n   to motion should multiply durations by var(--motion-scale). */\n\n@media (prefers-reduced-motion: reduce) {\n  :root {\n    --motion-scale: 0;\n    --duration-75: 1ms;\n    --duration-100: 1ms;\n    --duration-150: 1ms;\n    --dur