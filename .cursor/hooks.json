{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/restart-desktop-dev.ps1 -Mode mark",
        "timeout": 30
      }
    ],
    "afterTabFileEdit": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/restart-desktop-dev.ps1 -Mode mark",
        "timeout": 30
      }
    ],
    "stop": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/restart-desktop-dev.ps1 -Mode restartIfMarked",
        "timeout": 30
      }
    ]
  }
}
