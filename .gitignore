# Environment
.env
.env.local
.env.*.local

# Test artifacts
dogfood-output/

# Phase 4 review diff snapshots (temporary, regenerated each review round)
.review-diffs/

# Browser automation test artifacts (screenshots, videos, documents)
test-artifacts/

# Trae auto-generated code review snapshots (pre-push review artifacts)
trae-agentReviewBeforePushToRemote/

# Deprecated Electron-era planning documents (Rust + Tauri is the current target)
digitalLife/



# Git worktrees (isolated workspaces)
.worktrees/

# Superpower IDE runtime cache
.superpowers/

# Closing-workflow review snapshots (regenerable via git diff, deleted in Step 5)
.review-diffs/

# Local release staging (installer copies, generated manifests; regenerable)
.release/

# External reference code (not part of the project, for learning/reference only)
references/bklit-ui/

# CodeGraph local knowledge graph (SQLite, regenerable via `codegraph init`)
.codegraph/
# Playwright CLI output (may contain credentials)
.playwright-cli/
# Python bytecode from skill scripts (regenerable, tied to interpreter version)
__pycache__/

