#!/bin/sh
# pre-commit: 快静态子集（staged 文件 + 仓库不变量）。
# Husky + lint-staged 负责 staged 文件的 Prettier 规范化；ESLint 与仓库不变量在此执行。
# 慢门禁留在 pre-push；全量门禁需用户批准（ADL_PREPUSH_FULL=1）。
# 设计原则：hook 内只跑秒级检查；任何失败都直接阻断提交并打印修复命令。
set -e
ROOT="$(git rev-parse --show-toplevel)"
# 链接工作树里 git 会给 hook 注入 GIT_DIR；子进程继承后会操作真实仓库而非临时仓库，
# 与 pre-push 同源，统一剥离（见 .husky/pre-push 注释）。
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX
STAGED="$(git diff --cached --name-only --diff-filter=ACMR)"

# 失败步骤名：`set -e` 只给退出码，排障时必须能看出停在哪一步。
STEP="init"
on_exit() {
  code=$?
  if [ "$code" -ne 0 ]; then
    echo "[pre-commit] FAILED at step: $STEP (exit $code)" >&2
  fi
}
trap on_exit EXIT

# 1) staged 前端源码：eslint（plain, no --fix：hook 内不改写文件）
STEP="eslint"
LINTABLE="$(echo "$STAGED" | grep -E '^adlo/frontend/.*\.(ts|tsx|js|jsx|mjs|cjs)$' || true)"
if [ -n "$LINTABLE" ]; then
  echo "$LINTABLE" | sed 's|^adlo/frontend/||' | ( cd "$ROOT/adlo/frontend" && xargs -d '\n' -n 40 npx eslint --max-warnings 0 --no-warn-ignored )
else
  echo "[pre-commit] eslint: no staged frontend sources, skipped"
fi

# 2) staged 可格式化文件：lint-staged + Prettier 自动修复后重新暂存（只动暂存文件）
# 直调本地二进制而不是 `pnpm exec`：pnpm 在 git 钩子进程树里会偶发打不开自己的
# SQLite 状态库（`unable to open database file`），使任何提交都失败。
# 暂存文件不在 lint-staged glob 内时整步跳过，避免空跑。
STEP="lint-staged"
FORMATTABLE="$(echo "$STAGED" | grep -E '^adlo/frontend/|^adlo/scripts/.*\.mjs$' || true)"
if [ -n "$FORMATTABLE" ]; then
  ( cd "$ROOT" && node node_modules/lint-staged/bin/lint-staged.js )
else
  echo "[pre-commit] lint-staged: no matching staged files, skipped"
fi
echo "[pre-commit] 提示：编辑源码/文档请用 edit/write 工具；禁止 shell 批量改写（见 .agents/rules/shell-encoding.md）"

# 3) staged 脚本语法（dev tooling 在 eslint/tsc 范围外，pre-push 只在推送时查）
STEP="node --check"
MJSFILES="$(echo "$STAGED" | grep -E '^adlo/.*\.mjs$' || true)"
if [ -n "$MJSFILES" ]; then
  echo "$MJSFILES" | xargs -d '\n' -I{} sh -c 'node --check "$1"' _ {}
  STEP="script lint"
  ( cd "$ROOT" && echo "$MJSFILES" | xargs -d '\n' node adlo/scripts/check-script-lint.mjs )
else
  echo "[pre-commit] node --check: no staged .mjs files, skipped"
fi

# 4) 会话注册表：活动会话必须与当前分支一致（分支漂移会误导后续会话）
STEP="worktree session"
( cd "$ROOT" && node adlo/scripts/worktree-session.mjs check )

# 5) 仓库不变量（秒级）：i18n 对等、术语表、死代码、vite 配置冒烟、dev tooling 单测、删除 crate 术语
STEP="check:i18n"
( cd "$ROOT/adlo/frontend" && pnpm run check:i18n )
STEP="check:i18n:orphans"
( cd "$ROOT/adlo/frontend" && pnpm run check:i18n:orphans:changed )
STEP="check:glossary"
( cd "$ROOT/adlo/frontend" && pnpm run check:glossary )
STEP="check:css-vars"
( cd "$ROOT/adlo" && node scripts/check-css-vars.mjs )
STEP="check:dead-code"
( cd "$ROOT/adlo/frontend" && pnpm run check:dead-code )
STEP="check-unsafe-safety"
( cd "$ROOT/adlo" && node scripts/check-unsafe-safety.mjs )
STEP="check:vite-config"
( cd "$ROOT/adlo/frontend" && pnpm run check:vite-config )
STEP="check-brand"
( cd "$ROOT/adlo" && node scripts/check-brand.mjs )
STEP="check-stale-terms"
( cd "$ROOT/adlo" && node scripts/check-stale-terms.mjs )
STEP="check-deleted-crates"
( cd "$ROOT/adlo" && node scripts/check-deleted-crates.mjs )
STEP="check-no-new-any"
( cd "$ROOT/adlo" && node scripts/check-no-new-any.mjs )
STEP="notices:check"
DEPS="$(echo "$STAGED" | grep -E '^adlo/(Cargo\.lock|Cargo\.toml|package\.json|pnpm-lock\.yaml|pnpm-workspace\.yaml)$|^adlo/frontend/package\.json$' || true)"
if [ -n "$DEPS" ]; then
  ( cd "$ROOT/adlo" && pnpm run notices:check )
else
  echo "[pre-commit] notices:check: no dependency manifests staged, skipped"
fi
STEP="dev tooling tests"
( cd "$ROOT/adlo" && node --test "scripts/*.test.mjs" )

echo "[pre-commit] OK (tsc + vitest stay in check:changed / pre-push)"
