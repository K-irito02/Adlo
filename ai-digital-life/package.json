{
  "name": "ai-digital-life",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "node ./scripts/run-project-surface.mjs tauri",
    "dev:browser": "node ./scripts/run-project-surface.mjs browser",
    "dev:both": "node ./scripts/run-project-surface.mjs both",
    "dev:tauri": "node ./scripts/run-project-surface.mjs tauri",
    "dev:preview": "node ./frontend/dev/ad-server-launch.mjs",
    "dev:status": "node ./scripts/dev-status.mjs",
    "build": "cargo tauri build",
    "frontend:dev": "pnpm --dir frontend run dev",
    "frontend:build": "pnpm --dir frontend run build",
    "frontend:typecheck": "pnpm --dir frontend run typecheck",
    "frontend:test": "pnpm --dir frontend run test",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "setup:worktree": "node ./scripts/setup-worktree.mjs",
    "scripts:format:check": "node frontend/node_modules/prettier/bin/prettier.cjs --check \"scripts/**/*.mjs\" \"frontend/dev/**/*.mjs\" \"frontend/vite.config.ts\" \"frontend/scripts/check-vite-config.mjs\"",
    "scripts:format": "node frontend/node_modules/prettier/bin/prettier.cjs --write \"scripts/**/*.mjs\" \"frontend/dev/**/*.mjs\" \"frontend/vite.config.ts\" \"frontend/scripts/check-vite-config.mjs\"",
    "stage:sidecar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-stage-sidecar.ps1 -Profile debug",
    "cargo:check": "pnpm run stage:sidecar && cargo check --workspace",
    "cargo:clippy": "pnpm run stage:sidecar && cargo clippy --workspace --all-targets -- -D warnings",
    "cargo:test": "pnpm run stage:sidecar && cargo test --workspace",
    "cargo:fmt": "cargo fmt --all",
    "cargo:fmt:check": "cargo fmt --all -- --check",
    "frontend:lint": "pnpm --dir frontend run lint",
    "frontend:lint:fix": "pnpm --dir frontend run lint:fix",
    "frontend:format": "pnpm --dir frontend run format",
    "frontend:format:check": "pnpm --dir frontend run format:check",
    "fixtures:preview": "node ./scripts/make-preview-fixtures.mjs",
    "frontend:check:full": "pnpm --dir frontend run check:full",
    "check:all": "pnpm run test:scripts && pnpm run cargo:fmt:check && pnpm run cargo:clippy && pnpm run cargo:check && pnpm run cargo:test && pnpm run frontend:check:full"
  },
  "packageManager": "pnpm@11.5.2+sha512.71c631e382066efc25625d5cf029075de07b61b37f6e27350fbd84b1bda5864c8c1967adc280776b45c30a715c0359a3be08fef42d5bb09e2b99029979692916",
  "devDependencies": {
    "adm-zip": "^0.5.16"
  }
}
