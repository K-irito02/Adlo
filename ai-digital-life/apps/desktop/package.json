{
  "name": "@ai-digital-life/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "vite build",
    "start": "electron ./dist/main/index.js",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit && tsc -p tsconfig.renderer.json --noEmit"
  },
  "dependencies": {
    "@ai-digital-life/config": "file:../../packages/config",
    "@ai-digital-life/kernel": "file:../../packages/kernel",
    "@ai-digital-life/logger": "file:../../packages/logger",
    "@ai-digital-life/retrieval-worker": "file:../../workers/health",
    "@ai-digital-life/storage": "file:../../packages/storage",
    "@ai-digital-life/workspace": "file:../../packages/workspace"
  }
}
