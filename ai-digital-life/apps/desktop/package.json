{
  "name": "@ai-digital-life/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "vite build",
    "start": "electron ./dist/main/index.js",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit && tsc -p tsconfig.renderer.json --noEmit"
  },
  "dependencies": {
    "@ai-digital-life/agent-runtime": "file:../../packages/agent-runtime",
    "@ai-digital-life/change-engine": "file:../../packages/change-engine",
    "@ai-digital-life/config": "file:../../packages/config",
    "@ai-digital-life/context-engine": "file:../../packages/context-engine",
    "@ai-digital-life/conversation": "file:../../packages/conversation",
    "@ai-digital-life/editor": "file:../../packages/editor",
    "@ai-digital-life/errors": "file:../../packages/errors",
    "@ai-digital-life/events": "file:../../packages/events",
    "@ai-digital-life/fs-ops": "file:../../packages/fs-ops",
    "@ai-digital-life/kernel": "file:../../packages/kernel",
    "@ai-digital-life/logger": "file:../../packages/logger",
    "@ai-digital-life/migration": "file:../../packages/migration",
    "@ai-digital-life/model-gateway": "file:../../packages/model-gateway",
    "@ai-digital-life/prompt-engine": "file:../../packages/prompt-engine",
    "@ai-digital-life/retrieval-worker": "file:../../workers/health",
    "@ai-digital-life/storage": "file:../../packages/storage",
    "@ai-digital-life/task": "file:../../packages/task",
    "@ai-digital-life/terminal": "file:../../packages/terminal",
    "@ai-digital-life/workspace": "file:../../packages/workspace",
    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": "^0.52.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2"
  }
}
