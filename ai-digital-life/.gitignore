# Rust
/target/
**/target/
/target-codex*/

# Tauri
/src-tauri/target/

# Bundled adl-server sidecar staging (regenerated by build-stage-sidecar.ps1)
# Keep only the .gitkeep placeholder.
/src-tauri/binaries/*.exe

# Frontend
/frontend/node_modules/
/frontend/dist/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
*.swp
*.swo

# Environment
.env
.env.local

# Local dev runtime logs
/.run-logs/
/*.log

# Site-meta cache (generated by preview service at workspace root)
/.adl-cache/
.adl-cache/

# Temporary pnpm stores (created during build debugging)
/.local-store/

# Tauri auto-generated schemas
/src-tauri/gen/

# TypeScript incremental build cache
*.tsbuildinfo

# Compiled picker binary (regenerated from FolderPicker.cs)
/frontend/dev/picker/*.exe

# ts-rs auto-generated bindings (regenerated by cargo build)
**/bindings/

# Diagnostic logs (generated by diagnostic server)
/diagnostic-logs/

# Git worktree isolation
/.worktrees/

# ad-server config/test pollution (generated config for commands-config at crate cwd)
/crates/server/config/

# Agent-sandbox command marker files (PID + UUID naming, always 0 bytes, created in cwd)
/_tmp_*

# 临时审查快照目录（Phase 4 审查用，收尾删除）
.review-diffs/
