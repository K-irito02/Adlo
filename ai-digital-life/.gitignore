# Rust
/target/
**/target/
/target-codex*/

# Tauri
/src-tauri/target/

# Frontend
/frontend/node_modules/
/frontend/dist/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
*.swp
*.swo

# Environment
.env
.env.local

# Local dev runtime logs
/.run-logs/
/*.log

# Site-meta cache (generated by preview service at workspace root)
/.adl-cache/
.adl-cache/

# Temporary pnpm stores (created during build debugging)
/.local-store/

# Tauri auto-generated schemas
/src-tauri/gen/

# TypeScript incremental build cache
*.tsbuildinfo

# Playwright test results
/frontend/test-results/
/frontend/playwright-report/
/frontend/blob-report/

# Playwright browsers
ms-playwright/

# Compiled picker binary (regenerated from FolderPicker.cs)
/frontend/dev/picker/*.exe

# ts-rs auto-generated bindings (regenerated by cargo build)
**/bindings/

# Diagnostic logs (generated by diagnostic server)
/diagnostic-logs/

# Git worktree isolation
/.worktrees/

# Cargo disk-clean 时间戳（本机状态）
/.cargo/.disk-clean-stamp
