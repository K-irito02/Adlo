{
  "name": "ai-digital-life-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:preview": "node dev/ad-server-launch.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:dev": "tsc --noEmit -p dev/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:changed": "vitest run --changed",
    "coverage": "vitest run --coverage",
    "build:analyze": "BUILD_ANALYZE=true vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "check:i18n": "tsx scripts/check-i18n-coverage.ts",
    "check:glossary": "tsx scripts/check-glossary.ts",
    "gen:md-theme": "node scripts/generate-md-theme-vars.mjs",
    "gen:check": "node scripts/generate-md-theme-vars.mjs && git diff --exit-code -- src/styles/vendor",
    "check:static": "pnpm lint && pnpm typecheck && pnpm typecheck:dev && pnpm format:check && pnpm check:i18n && pnpm check:glossary && pnpm gen:check",
    "check:changed": "node scripts/check-changed.mjs",
    "check:full": "pnpm check:static && pnpm test"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
