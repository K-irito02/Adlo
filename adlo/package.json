{
  "name": "adlo",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "node ./scripts/run-project-surface.mjs tauri",
    "dev:browser": "node ./scripts/run-project-surface.mjs browser",
    "dev:both": "node ./scripts/run-project-surface.mjs both",
    "dev:tauri": "node ./scripts/run-project-surface.mjs tauri",
    "dev:preview": "node ./frontend/dev/ad-server-launch.mjs",
    "dev:status": "node ./scripts/dev-status.mjs",
    "dev:stop": "node ./scripts/stop-project-surface.mjs",
    "prototype:serve": "node ./scripts/serve-prototype.mjs",
    "worktree:env": "node ./scripts/worktree-env.mjs",
    "worktree:disk": "node ./scripts/worktree-disk.mjs",
    "worktree:sessions": "node ./scripts/worktree-sessions.mjs",
    "worktree:session": "node ./scripts/worktree-session.mjs",
    "skills:audit": "node ./scripts/skills-sync.mjs audit",
    "skills:apply": "node ./scripts/skills-sync.mjs apply",
    "skills:mirror": "node ./scripts/skills-sync.mjs mirror",
    "skills:lock": "node ./scripts/skills-sync.mjs lock",
    "skills:docs": "node ./scripts/skills-sync.mjs docs",
    "skills:verify": "node ./scripts/skills-sync.mjs verify",
    "skills:update": "node ./scripts/skills-sync.mjs apply --all",
    "agents:mirror": "node ./scripts/agents-mirror.mjs",
    "agents:verify": "node ./scripts/agents-mirror.mjs --check",
    "serve:server": "node ./scripts/serve-adl-server.mjs",
    "test:env-path": "cargo test -p adl-server --test env_path_cli",
    "review:snapshot": "node ./scripts/review-snapshot.mjs",
    "check:review-gate": "node ./scripts/check-review-gate.mjs --phase r2",
    "check:rust:changed": "node ./scripts/check-rust-changed.mjs",
    "build": "cargo tauri build",
    "release:bump": "node ./scripts/release.mjs bump",
    "release:build": "node ./scripts/release.mjs build",
    "release:publish": "node ./scripts/release.mjs publish",
    "release:verify": "node ./scripts/release.mjs verify",
    "notices:generate": "node ./scripts/generate-third-party-notices.mjs",
    "notices:check": "node ./scripts/generate-third-party-notices.mjs --check --offline",
    "notices:inspect": "node ./scripts/generate-third-party-notices.mjs --stats --offline",
    "probe:net": "node ./scripts/net-probe.mjs",
    "log:tail": "node ./scripts/log-tail.mjs",
    "frontend:dev": "pnpm --dir frontend run dev",
    "frontend:build": "pnpm --dir frontend run build",
    "frontend:typecheck": "pnpm --dir frontend run typecheck",
    "frontend:test": "pnpm --dir frontend run test",
    "test:scripts": "node --test \"scripts/*.test.mjs\" \"frontend/scripts/*.test.mjs\"",
    "check:brand": "node ./scripts/check-brand.mjs",
    "check:stale-terms": "node ./scripts/check-stale-terms.mjs",
    "check:deleted-crates": "node ./scripts/check-deleted-crates.mjs",
    "check:no-new-any": "node ./scripts/check-no-new-any.mjs",
    "check:script-lint": "node ./scripts/check-script-lint.mjs",
    "check:comment-claims": "node ./scripts/check-comment-claims.mjs",
    "check:context-budget": "node ./scripts/check-context-budget.mjs",
    "check:ui-manual": "node ./scripts/check-ui-manual-selectors.mjs",
    "check:kb-counts": "node ./scripts/check-kb-counts.mjs",
    "check:skills": "node ./scripts/skills-sync.mjs docs --check && node ./scripts/skills-sync.mjs mirror --check --all",
    "check:glossary": "node frontend/scripts/check-glossary.ts",
    "check:css-globals": "node ./scripts/check-css-globals.mjs",
    "check:css-vars": "node ./scripts/check-css-vars.mjs",
    "check:docs-links": "node ./scripts/check-docs-links.mjs",
    "check:repo": "pnpm run check:css-globals && pnpm run check:css-vars && pnpm run check:docs-links && pnpm run check:brand && pnpm run check:stale-terms && pnpm run check:deleted-crates && pnpm run check:context-budget && pnpm run check:ui-manual && pnpm run check:kb-counts && pnpm run check:skills && pnpm run check:glossary && pnpm run check:script-lint && pnpm run test:scripts && pnpm run scripts:format:check && pnpm run e2e:typecheck",
    "setup:worktree": "node ./scripts/setup-worktree.mjs",
    "push:both": "node ./scripts/push-both.mjs",
    "scripts:format:check": "node frontend/node_modules/prettier/bin/prettier.cjs --check \"scripts/**/*.mjs\" \"frontend/dev/**/*.mjs\" \"frontend/scripts/**/*.mjs\" \"frontend/vite.config.ts\"",
    "scripts:format": "node frontend/node_modules/prettier/bin/prettier.cjs --write \"scripts/**/*.mjs\" \"frontend/dev/**/*.mjs\" \"frontend/scripts/**/*.mjs\" \"frontend/vite.config.ts\"",
    "stage:sidecar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-stage-sidecar.ps1 -Profile debug",
    "cargo:build": "pnpm run stage:sidecar && cargo build --workspace",
    "cargo:check": "pnpm run stage:sidecar && cargo check --workspace",
    "cargo:clippy": "pnpm run stage:sidecar && cargo clippy --workspace --all-targets -- -D warnings",
    "cargo:test": "pnpm run stage:sidecar && cargo test --workspace",
    "cargo:fmt": "cargo fmt --all",
    "cargo:fmt:check": "cargo fmt --all -- --check",
    "frontend:lint": "pnpm --dir frontend run lint",
    "frontend:lint:fix": "pnpm --dir frontend run lint:fix",
    "frontend:format": "pnpm --dir frontend run format",
    "frontend:format:check": "pnpm --dir frontend run format:check",
    "fixtures:preview": "node ./scripts/make-preview-fixtures.mjs",
    "e2e:build": "pnpm run stage:sidecar && cargo tauri build --debug --no-bundle --features e2e --config e2e/tauri.e2e.conf.json",
    "e2e": "pnpm --dir e2e run test",
    "e2e:typecheck": "node ./scripts/e2e-typecheck.mjs",
    "frontend:check:full": "pnpm --dir frontend run check:full",
    "check:all": "pnpm run check:repo && pnpm run cargo:fmt:check && pnpm run cargo:clippy && pnpm run cargo:check && pnpm run notices:check && pnpm run cargo:test && pnpm run frontend:check:full"
  },
  "packageManager": "pnpm@11.5.2+sha512.71c631e382066efc25625d5cf029075de07b61b37f6e27350fbd84b1bda5864c8c1967adc280776b45c30a715c0359a3be08fef42d5bb09e2b99029979692916",
  "devDependencies": {
    "adm-zip": "^0.5.16"
  }
}
