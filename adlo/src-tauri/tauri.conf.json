{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Adlo",
  "version": "0.1.0",
  "identifier": "com.adlo.app",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": {
      "script": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-stage-sidecar.ps1 -Profile debug",
      "wait": true
    },
    "beforeBuildCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-stage-sidecar.ps1 -Profile release && pnpm --dir frontend run build",
    "beforeBundleCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/copy-adl-server-sidecar.ps1 -Profile release"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Adlo",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --allow-file-access-from-files"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https: http:; img-src 'self' data: blob: https: http:; media-src 'self' data: blob: https: http:; frame-src 'self' https: http:",
      "dangerousDisableAssetCspModification": ["style-src"]
    },
    "withGlobalTauri": false
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://gitee.com/K_irito/Adlo/raw/main/release/latest.json",
        "https://github.com/K-irito02/Adlo/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5MTkwODkwREQ3OUE1MjIKUldRaXBYbmRrQWdaR2QybER6VmVvVThudEhIRjlUQjgwVWtiSEtPZVhrTGNYQlVCNUtuSWhaQXUK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": ["resources/env-baseline.json"],
    "externalBin": ["binaries/adl-server"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
